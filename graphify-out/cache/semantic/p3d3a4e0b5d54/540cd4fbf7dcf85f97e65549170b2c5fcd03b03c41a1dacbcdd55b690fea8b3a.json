{"nodes": [{"id": "src_recycleguard_domain_readme", "label": "C08 Deterministic Domain Tools README", "file_type": "document", "source_file": "src/recycleguard/domain/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": "Sushanth S", "contributor": null}, {"id": "src_recycleguard_domain_readme_whole_snapshot_universe", "label": "Whole Pinned Snapshot Is The Checked Universe", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Request subjects only select which results come back; checks always run against every active record so selection cannot hide contradictions."}, {"id": "src_recycleguard_domain_readme_affirmative_evidence_demotes", "label": "Only Affirmative Evidence Demotes (UNKNOWN Default)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L7-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing, unreviewed or undated evidence is UNKNOWN, never a silent pass and never an exclusion; checks only demote and never promote support."}, {"id": "src_recycleguard_domain_readme_decimal_string_arithmetic", "label": "Decimal Strings, 4dp ROUND_HALF_EVEN, Never Float", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L3-L4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure functions over the pinned snapshot with no clock and no I/O except archiving result blobs, keeping results deterministic and reproducible."}, {"id": "src_recycleguard_domain_readme_universe_module", "label": "universe.py: Active Records, Supersession, Ambiguity", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_allocation_conservation", "label": "Lot Capacity And Allocation Conservation (S03)", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_earlier_liability_priority", "label": "Earlier-Liability Order (F08)", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_chronology_rule", "label": "Chronology Verdict Rule (Half-Open Spans, Ties Are UNKNOWN)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L16, L30-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicit allocation_order beats Allocation.allocation_time; a transfer's time is never used as allocation time; missing, partial or tied order is UNKNOWN."}, {"id": "src_recycleguard_domain_readme_lifecycle_rule", "label": "Lifecycle Verdict Rule (F09 Expired/Cancelled Credits)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L17, L26-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FAIL only when a supported EXPIRED/CANCELLED fact precedes transfer or allocation; absence of terminal evidence passes but the trace notes absence is not proof; unsupported, undated or unorderable facts are UNKNOWN."}, {"id": "src_recycleguard_domain_readme_identity_registration", "label": "Identity And Registrations (F05)", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_capability_rule", "label": "Capability Verdict Rule (F10 EEE Code Coverage)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L32-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies only when both a Registration and a ProductMapping exist; FAIL when no EEE code is covered, UNKNOWN when only some are; a purely alphabetic code (CEEW) covers numbered items (CEEW1), others match exactly."}, {"id": "src_recycleguard_domain_readme_commercial_rule", "label": "Commercial Verdict Rule (F07/T09 Invoice-Payment Grouping)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L20, L36-L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An invoice and its payment count once and money is never credit; contradictions in parties, metal or quantity fail the whole linked group, and rejected groups consume no commercial transfer capacity (tool version c08-s04-0.2)."}, {"id": "src_recycleguard_domain_readme_weight_basis_conflict", "label": "WEIGHT_BASIS_CONFLICT (F13)", "file_type": "rationale", "source_file": "src/recycleguard/domain/README.md", "source_location": "L19, L42-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two bases or weights in force together are escalated, never averaged; sales aggregated per basis; fiscal years run 1 April to 1 April."}, {"id": "src_recycleguard_domain_readme_tool_version", "label": "TOOL_VERSION In Calculation Digest", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because TOOL_VERSION is part of the calculation digest, any rule change must bump it so pinned runs remain reproducible."}, {"id": "src_recycleguard_domain_readme_run_check", "label": "run_check Allowlisted Dispatcher", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L21, L49-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts only an allowlist of check kinds (COMPARE_IDENTITY, LOOKUP_REGISTRATION_EVIDENCE, CHECK_CAPABILITY, LOOKUP_PRODUCT_MAPPING, COMPARE_WEIGHT_BASIS, AGGREGATE_SALES, GET_CERTIFICATE_HISTORY, CHECK_CREDIT_EVENTS, MATCH_TRANSACTIONS); unknown kinds are rejected."}, {"id": "src_recycleguard_domain_readme_structuredcheckresult", "label": "StructuredCheckResult", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_check_id_hash", "label": "Deterministic check_id Hash", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L52-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hash of membership digest, tool version, kind and subjects so identical inputs give the same result and blob."}, {"id": "src_recycleguard_domain_readme_reconciliation_engine", "label": "Reconciliation Engine And ServiceResult Wrapper", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_recycleguard_domain_readme_s04_deferred_scope", "label": "Deferred From S04 (read_scope, list_evidence, A07 Wiring)", "file_type": "concept", "source_file": "src/recycleguard/domain/README.md", "source_location": "L55-L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_recycleguard_domain_readme", "target": "src_recycleguard_domain_readme_whole_snapshot_universe", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/recycleguard/doma