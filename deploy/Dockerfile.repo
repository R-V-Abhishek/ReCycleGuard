# The evaluator side: coordinator, scorer and tests. Never used to run an investigator.
FROM ghcr.io/astral-sh/uv:0.9.7 AS uv
FROM docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker-cli

FROM python:3.12-slim-bookworm@sha256:e697c81897302a4c4333bade000d98038fbb21eb064f8ee1fd42d02ebcd9d337 AS trials
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /repo
COPY . .
RUN git config --global --add safe.directory /repo
RUN UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --locked
ENV PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin" PYTHONUNBUFFERED=1

FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS node

FROM trials AS test
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && cd ui && npm ci
