{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "DenseConfiguration": {
      "additionalProperties": false,
      "description": "Dense vector indexing configuration if external embeddings enabled.",
      "properties": {
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "integer"
        },
        "normalize": {
          "default": true,
          "title": "Normalize",
          "type": "boolean"
        },
        "tokenizer_name": {
          "title": "Tokenizer Name",
          "type": "string"
        },
        "vector_blob_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Vector Blob Digest",
          "type": "string"
        }
      },
      "required": [
        "model_name",
        "revision",
        "dimension",
        "tokenizer_name",
        "vector_blob_digest"
      ],
      "title": "DenseConfiguration",
      "type": "object"
    },
    "LexicalConfiguration": {
      "additionalProperties": false,
      "description": "Configuration parameters for SQLite FTS5 lexical index.",
      "properties": {
        "tokenizer": {
          "default": "unicode61",
          "title": "Tokenizer",
          "type": "string"
        },
        "bm25_k1": {
          "default": 1.2,
          "title": "Bm25 K1",
          "type": "number"
        },
        "bm25_b": {
          "default": 0.75,
          "title": "Bm25 B",
          "type": "number"
        },
        "indexed_columns": {
          "items": {
            "type": "string"
          },
          "title": "Indexed Columns",
          "type": "array"
        }
      },
      "title": "LexicalConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Integrity and membership manifest for a frozen index (CONTRACTS §6.1).",
  "properties": {
    "index_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Index Id",
      "type": "string"
    },
    "corpus_snapshot_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Corpus Snapshot Id",
      "type": "string"
    },
    "eligible_members_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Eligible Members Digest",
      "type": "string"
    },
    "extraction_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Extraction Versions",
      "type": "object"
    },
    "lexical_configuration": {
      "$ref": "#/$defs/LexicalConfiguration"
    },
    "dense_configuration_or_null": {
      "anyOf": [
        {
          "$ref": "#/$defs/DenseConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build_code_revision": {
      "title": "Build Code Revision",
      "type": "string"
    },
    "index_files": {
      "items": {
        "type": "string"
      },
      "title": "Index Files",
      "type": "array"
    },
    "integrity_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Integrity Digest",
      "type": "string"
    },
    "total_chunks": {
      "default": 0,
      "title": "Total Chunks",
      "type": "integer"
    },
    "corpus_membership_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Membership Digest"
    },
    "index_blob": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retrieval_configuration_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Configuration Id"
    }
  },
  "required": [
    "index_id",
    "corpus_snapshot_id",
    "eligible_members_digest",
    "extraction_versions",
    "lexical_configuration",
    "build_code_revision",
    "index_files",
    "integrity_digest"
  ],
  "title": "IndexManifest",
  "type": "object"
}
