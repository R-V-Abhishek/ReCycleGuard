{
  "$defs": {
    "PromptText": {
      "additionalProperties": false,
      "description": "The whole text of one prompt version. A configuration carries it to the investigator.",
      "properties": {
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "phase_rules": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "PLAN",
              "ASSESS",
              "READ",
              "ANALYZE"
            ]
          },
          "title": "Phase Rules",
          "type": "object"
        },
        "retry_note": {
          "minLength": 1,
          "title": "Retry Note",
          "type": "string"
        }
      },
      "required": [
        "prompt_version",
        "system",
        "phase_rules",
        "retry_note"
      ],
      "title": "PromptText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration_id": {
      "default": "configuration:u01_local_qwen35_9b",
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Configuration Id",
      "type": "string"
    },
    "backend": {
      "default": "mlx",
      "enum": [
        "mlx",
        "llama_cpp"
      ],
      "title": "Backend",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_path": {
      "format": "path",
      "title": "Model Path",
      "type": "string"
    },
    "model_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Model Revision",
      "type": "string"
    },
    "weights_manifest_path": {
      "format": "path",
      "title": "Weights Manifest Path",
      "type": "string"
    },
    "weights_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Weights Manifest Digest",
      "type": "string"
    },
    "runtime_lock_path": {
      "format": "path",
      "title": "Runtime Lock Path",
      "type": "string"
    },
    "runtime_lock_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Lock Digest",
      "type": "string"
    },
    "runtime_version": {
      "default": "0.32.2",
      "minLength": 1,
      "title": "Runtime Version",
      "type": "string"
    },
    "prompt_template_id": {
      "default": "prompt:u01_qwen_non_thinking_v7",
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Prompt Template Id",
      "type": "string"
    },
    "prompt_version": {
      "default": "u01_non_thinking_v7",
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "prompt": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptText"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "endpoint": {
      "default": "http://127.0.0.1:8080/v1/completions",
      "title": "Endpoint",
      "type": "string"
    },
    "max_output_tokens": {
      "default": 1024,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "max_total_tokens": {
      "default": 32768,
      "minimum": 1,
      "title": "Max Total Tokens",
      "type": "integer"
    },
    "timeout_seconds": {
      "default": 120.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "max_model_calls": {
      "default": 12,
      "maximum": 12,
      "minimum": 1,
      "title": "Max Model Calls",
      "type": "integer"
    },
    "stop_sequences": {
      "default": [
        "<|im_end|>",
        "<|endoftext|>"
      ],
      "items": {
        "type": "string"
      },
      "title": "Stop Sequences",
      "type": "array"
    },
    "server_flags": {
      "default": [
        "--decode-concurrency",
        "1",
        "--prompt-concurrency",
        "1",
        "--prompt-cache-size",
        "1",
        "--prefill-step-size",
        "256",
        "--max-tokens",
        "1024"
      ],
      "items": {
        "type": "string"
      },
      "title": "Server Flags",
      "type": "array"
    }
  },
  "required": [
    "model_id",
    "model_path",
    "model_revision",
    "weights_manifest_path",
    "weights_manifest_digest",
    "runtime_lock_path",
    "runtime_lock_digest"
  ],
  "title": "LocalModelConfig",
  "type": "object"
}
