{
  "$defs": {
    "JsonValue": {},
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DATE",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone"
        },
        "interpretation_status": {
          "enum": [
            "PARSED",
            "REVIEWED",
            "AMBIGUOUS",
            "UNKNOWN"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw and parsed observation with extraction provenance and temporal triad (CONTRACTS §3.3).",
  "properties": {
    "observation_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Observation Id",
      "type": "string"
    },
    "extraction_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Extraction Id",
      "type": "string"
    },
    "artifact_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Artifact Revision Id",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/Locator"
    },
    "observation_type": {
      "title": "Observation Type",
      "type": "string"
    },
    "raw_fields": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Raw Fields",
      "type": "object"
    },
    "parsed_fields": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parsed Fields",
      "type": "object"
    },
    "validation_state": {
      "enum": [
        "VALID",
        "REVIEW_REQUIRED",
        "INVALID"
      ],
      "title": "Validation State",
      "type": "string"
    },
    "extraction_method": {
      "enum": [
        "CSV",
        "JSON",
        "PDF_TEXT",
        "PDF_TABLE",
        "OCR",
        "HUMAN_ASSERTION"
      ],
      "title": "Extraction Method",
      "type": "string"
    },
    "field_quality": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Field Quality",
      "type": "object"
    },
    "event_time": {
      "$ref": "#/$defs/TemporalValue"
    },
    "source_capture_time": {
      "$ref": "#/$defs/TemporalValue"
    },
    "ingestion_time": {
      "title": "Ingestion Time",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "extraction_id",
    "artifact_revision_id",
    "locator",
    "observation_type",
    "raw_fields",
    "parsed_fields",
    "validation_state",
    "extraction_method",
    "field_quality",
    "event_time",
    "source_capture_time",
    "ingestion_time"
  ],
  "title": "Observation",
  "type": "object"
}
