{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Issue Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "INVALID_SCHEMA",
            "ACCESS_DENIED",
            "HASH_MISMATCH",
            "MISSING_ARTIFACT",
            "INCOMPLETE_COVERAGE",
            "EXTRACTION_FAILED",
            "UNCONFIRMED_IDENTIFIER",
            "AMBIGUOUS_IDENTITY",
            "AMBIGUOUS_EVENT",
            "DIMENSION_MISMATCH",
            "NUMERIC_PRECISION_EXCEEDED",
            "EARLIER_LIABILITY_UNMET",
            "LIABILITY_PRIORITY_UNRESOLVED",
            "UNSUPPORTED_PROFILE",
            "UNAPPROVED_PROFILE",
            "APPLICABILITY_UNRESOLVED",
            "RULE_CONFLICT",
            "SOURCE_INCOMPLETE",
            "STALE_SNAPSHOT",
            "BUDGET_EXHAUSTED",
            "CYCLE_DETECTED",
            "PROVIDER_TIMEOUT",
            "PROVIDER_INVALID_OUTPUT",
            "AUDIT_UNAVAILABLE",
            "CONCURRENT_MODIFICATION",
            "STALE_REVIEW",
            "EXPORT_RESTRICTED",
            "PROHIBITED_VERDICT",
            "CANCELLED",
            "INTEGRITY_FAILED",
            "OVER_ALLOCATION",
            "UNSUPPORTED_FEATURE",
            "CREDIT_EXPIRED",
            "CREDIT_CANCELLED",
            "CAPABILITY_MISMATCH",
            "WEIGHT_BASIS_CONFLICT"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "field_path",
        "evidence_refs",
        "retryable"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Outcome of offline replay or recomputation (CONTRACTS §12).",
  "properties": {
    "replay_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Replay Id",
      "type": "string"
    },
    "mode": {
      "enum": [
        "ARTIFACT",
        "RECOMPUTE",
        "MODEL_RERUN"
      ],
      "title": "Mode",
      "type": "string"
    },
    "source_bundle_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Source Bundle Id",
      "type": "string"
    },
    "reconstructed_state_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Reconstructed State Refs",
      "type": "array"
    },
    "comparison_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Comparison Refs",
      "type": "array"
    },
    "new_run_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Run Id"
    },
    "integrity_result_ref": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Integrity Result Ref",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "replay_id",
    "mode",
    "source_bundle_id",
    "reconstructed_state_refs",
    "comparison_refs",
    "integrity_result_ref"
  ],
  "title": "ReplayResult",
  "type": "object"
}
