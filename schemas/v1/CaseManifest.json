{
  "$defs": {
    "AssetEntry": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "body_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Digest",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "logical_record_type": {
          "title": "Logical Record Type",
          "type": "string"
        },
        "source_capture_time": {
          "$ref": "#/$defs/TemporalValue"
        },
        "visibility": {
          "const": "VISIBLE",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "media_type",
        "body_digest",
        "byte_length",
        "logical_record_type",
        "source_capture_time",
        "visibility"
      ],
      "title": "AssetEntry",
      "type": "object"
    },
    "TableDisposition": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "title": "Table",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNSUPPORTED"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "table",
        "disposition",
        "reason"
      ],
      "title": "TableDisposition",
      "type": "object"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DATE",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone"
        },
        "interpretation_status": {
          "enum": [
            "PARSED",
            "REVIEWED",
            "AMBIGUOUS",
            "UNKNOWN"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Case Id",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "watermark": {
      "const": "SYNTHETIC - NOT A CPCB RECORD",
      "title": "Watermark",
      "type": "string"
    },
    "producer_entity_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Producer Entity Id",
      "type": "string"
    },
    "fiscal_year": {
      "pattern": "^\\d{4}-\\d{4}$",
      "title": "Fiscal Year",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "period_end_exclusive": {
      "format": "date",
      "title": "Period End Exclusive",
      "type": "string"
    },
    "quarter": {
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "ANNUAL"
      ],
      "title": "Quarter",
      "type": "string"
    },
    "allowed_eee_codes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Eee Codes",
      "type": "array"
    },
    "allowed_metals": {
      "items": {
        "enum": [
          "AU",
          "CU",
          "AL",
          "FE"
        ],
        "type": "string"
      },
      "title": "Allowed Metals",
      "type": "array"
    },
    "calculation_profile_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Calculation Profile Id",
      "type": "string"
    },
    "business_cutoff": {
      "$ref": "#/$defs/TemporalValue"
    },
    "knowledge_cutoff": {
      "title": "Knowledge Cutoff",
      "type": "string"
    },
    "adapter_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Adapter Versions",
      "type": "object"
    },
    "evidence_expectations": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Expectations",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetEntry"
      },
      "title": "Assets",
      "type": "array"
    },
    "optional_table_dispositions": {
      "items": {
        "$ref": "#/$defs/TableDisposition"
      },
      "title": "Optional Table Dispositions",
      "type": "array"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "REJECTED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "synthetic",
    "watermark",
    "producer_entity_id",
    "fiscal_year",
    "period_start",
    "period_end_exclusive",
    "quarter",
    "allowed_eee_codes",
    "allowed_metals",
    "calculation_profile_id",
    "business_cutoff",
    "knowledge_cutoff",
    "adapter_versions",
    "evidence_expectations",
    "assets",
    "optional_table_dispositions",
    "status"
  ],
  "title": "CaseManifest",
  "type": "object"
}
