          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Record Id",
      "type": "string"
    },
    "record_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Record Revision Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Case Id",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Observation Refs",
      "type": "array"
    },
    "derived_from_record_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Derived From Record Refs",
      "type": "array"
    },
    "validation_state": {
      "enum": [
        "VALID",
        "REVIEW_REQUIRED",
        "INVALID"
      ],
      "title": "Validation State",
      "type": "string"
    },
    "created_by_operation_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Created By Operation Id",
      "type": "string"
    },
    "supersedes_revision_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Revision Id"
    },
    "record_type": {
      "const": "CommercialRecord",
      "title": "Record Type",
      "type": "string"
    },
    "commercial_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Commercial Id",
      "type": "string"
    },
    "record_kind": {
      "enum": [
        "CONTRACT",
        "PO",
        "INVOICE",
        "PAYMENT"
      ],
      "title": "Record Kind",
      "type": "string"
    },
    "issuer_entity_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Issuer Entity Id",
      "type": "string"
    },
    "recipient_entity_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Recipient Entity Id",
      "type": "string"
    },
    "external_ref": {
      "minLength": 1,
      "title": "External Ref",
      "type": "string"
    },
    "event_time": {
      "$ref": "#/$defs/TemporalValue"
    },
    "linked_credit_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Linked Credit Refs",
      "type": "array"
    },
    "money": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "credit_quantity": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonnegativeMass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "record_id",
    "record_revision_id",
    "case_id",
    "observation_refs",
    "derived_from_record_refs",
    "validation_state",
    "created_by_operation_id",
    "supersedes_revision_id",
    "record_type",
    "commercial_id",
    "record_kind",
    "issuer_entity_id",
    "recipient_entity_id",
    "external_ref",
    "event_time",
    "linked_credit_refs"
  ],
  "title": "CommercialRecord",
  "type": "object"
}
