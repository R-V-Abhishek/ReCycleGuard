{
  "$defs": {
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Segmented unit of regulatory or table text with stable locator (CONTRACTS §6.1).",
  "properties": {
    "chunk_id": {
      "title": "Chunk Id",
      "type": "string"
    },
    "provision_version_id": {
      "title": "Provision Version Id",
      "type": "string"
    },
    "source_version_id": {
      "title": "Source Version Id",
      "type": "string"
    },
    "legal_path": {
      "title": "Legal Path",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/Locator"
    },
    "parent_provision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Provision Id"
    },
    "role_scope": {
      "default": "GENERAL",
      "title": "Role Scope",
      "type": "string"
    },
    "affected_roles": {
      "items": {
        "enum": [
          "PRODUCER",
          "MANUFACTURER",
          "RECYCLER",
          "REFURBISHER"
        ],
        "type": "string"
      },
      "title": "Affected Roles",
      "type": "array"
    },
    "regime": {
      "default": "E_WASTE_2022",
      "title": "Regime",
      "type": "string"
    },
    "disposition": {
      "default": "INDEXED",
      "enum": [
        "INDEXED",
        "EXCLUDED",
        "UNINDEXABLE"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "chunk_type": {
      "default": "PROVISION_CLAUSE",
      "enum": [
        "PROVISION_CLAUSE",
        "TABLE_ROW",
        "PAGE_SECTION",
        "TABLE_CELL"
      ],
      "title": "Chunk Type",
      "type": "string"
    },
    "char_start": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char Start"
    },
    "char_end": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char End"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "chunk_id",
    "provision_version_id",
    "source_version_id",
    "legal_path",
    "text",
    "locator"
  ],
  "title": "IndexedChunk",
  "type": "object"
}
