{
  "$defs": {
    "FindingProposal": {
      "additionalProperties": false,
      "description": "A model's suggested finding. It reaches a report only through the deterministic gate.\n\nReferences and scopes stay loose here so a bad citation is a retained gate rejection,\nnot a failed assessment.",
      "properties": {
        "issue_type": {
          "enum": [
            "F01_CLEAN_BASELINE",
            "F02_OVERLAPPING_EXPORT",
            "F03_MULTISTAGE_ID_REUSE",
            "F04_UNIT_DIMENSION_MIX",
            "F05_WRONG_ENTITY_ALIAS",
            "F06_STALE_SNAPSHOT",
            "F07_PAID_NO_TRANSFER",
            "F08_PRIOR_ARREARS_DRAIN",
            "F09_EXPIRED_CANCELLED",
            "F10_CAPABILITY_MISMATCH",
            "F11_WRONG_PERIOD_RULE",
            "F12_UNSEEN_NOTICE_LEAD",
            "F13_WEIGHT_BASIS_CONFLICT",
            "F14_OUT_OF_SCOPE_REGIME",
            "F15_EXTRACTION_PAGE_LOSS",
            "F16_PROMPT_INJECTION"
          ],
          "title": "Issue Type",
          "type": "string"
        },
        "advisory_status": {
          "enum": [
            "RECONCILED_WITHIN_SCOPE",
            "DISCREPANCY_DETECTED",
            "PENDING_VERIFICATION",
            "REQUIRES_EXPERT_REVIEW"
          ],
          "title": "Advisory Status",
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "abstention_reason": {
          "anyOf": [
            {
              "enum": [
                "MISSING_EVIDENCE",
                "MISSING_AUTHORITY",
                "RULE_CONFLICT",
                "TEMPORAL_UNCERTAINTY",
                "UNSUPPORTED_FEATURE",
                "INCOMPLETE_HISTORY",
                "BUDGET_LIMIT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstention Reason"
        },
        "withheld_claim_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Withheld Claim Scopes",
          "type": "array"
        },
        "next_action_kind": {
          "enum": [
            "INVESTIGATE",
            "REQUEST_EVIDENCE",
            "ESCALATE",
            "NO_FURTHER_ACTION"
          ],
          "title": "Next Action Kind",
          "type": "string"
        },
        "next_action_text": {
          "minLength": 1,
          "title": "Next Action Text",
          "type": "string"
        }
      },
      "required": [
        "issue_type",
        "advisory_status",
        "basis",
        "evidence_ref_ids",
        "next_action_kind",
        "next_action_text"
      ],
      "title": "FindingProposal",
      "type": "object"
    },
    "PlanDraft": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "proposed_checks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Proposed Checks",
          "type": "array"
        },
        "expected_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Evidence",
          "type": "array"
        },
        "stopping_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stopping Criteria",
          "type": "array"
        }
      },
      "required": [
        "objective",
        "hypotheses",
        "proposed_checks",
        "expected_evidence",
        "stopping_criteria"
      ],
      "title": "PlanDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "RESOLVE"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "SUPPORTS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revised_plan": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": [
              "WEAK",
              "REFUTES",
              "NO_PROGRESS",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "verdict": {
      "enum": [
        "SUPPORTS",
        "REFUTES",
        "WEAK",
        "NO_PROGRESS",
        "UNKNOWN"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "weak_result_or_mistake": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weak Result Or Mistake"
    },
    "next_check_or_stop": {
      "minLength": 1,
      "title": "Next Check Or Stop",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "CONTINUE",
        "RESOLVE",
        "ABSTAIN"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "revised_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "finding_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "verdict",
    "weak_result_or_mistake",
    "next_check_or_stop",
    "disposition",
    "revised_plan"
  ],
  "title": "AssessmentProposal",
  "type": "object"
}
