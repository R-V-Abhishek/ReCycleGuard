{
  "$defs": {
    "ProfileRef": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "digest"
      ],
      "title": "ProfileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "target": {
      "$ref": "#/$defs/ProfileRef"
    },
    "new_profile_version": {
      "minLength": 1,
      "title": "New Profile Version",
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "target",
    "new_profile_version",
    "decision",
    "reason"
  ],
  "title": "ProfileReview",
  "type": "object"
}
