{
  "additionalProperties": false,
  "description": "Explicit disclosure of omitted artifacts or derivative context in public exports.",
  "properties": {
    "object_ref": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Object Ref",
      "type": "string"
    },
    "object_kind": {
      "title": "Object Kind",
      "type": "string"
    },
    "restriction_reason": {
      "enum": [
        "RIGHTS_RESTRICTED",
        "PROMPT_DERIVATIVE_RESTRICTED",
        "SENSITIVE_DATA",
        "REDIS_NOT_PERMITTED",
        "CONFIDENTIAL"
      ],
      "title": "Restriction Reason",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "hash_disclosed": {
      "default": true,
      "title": "Hash Disclosed",
      "type": "boolean"
    },
    "original_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Sha256"
    }
  },
  "required": [
    "object_ref",
    "object_kind",
    "restriction_reason",
    "explanation"
  ],
  "title": "OmissionDisposition",
  "type": "object"
}
