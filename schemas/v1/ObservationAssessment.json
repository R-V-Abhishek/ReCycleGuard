{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FindingProposal": {
      "additionalProperties": false,
      "description": "A model's suggested finding. It reaches a report only through the deterministic gate.\n\nReferences and scopes stay loose here so a bad citation is a retained gate rejection,\nnot a failed assessment.",
      "properties": {
        "issue_type": {
          "enum": [
            "F01_CLEAN_BASELINE",
            "F02_OVERLAPPING_EXPORT",
            "F03_MULTISTAGE_ID_REUSE",
            "F04_UNIT_DIMENSION_MIX",
            "F05_WRONG_ENTITY_ALIAS",
            "F06_STALE_SNAPSHOT",
            "F07_PAID_NO_TRANSFER",
            "F08_PRIOR_ARREARS_DRAIN",
            "F09_EXPIRED_CANCELLED",
            "F10_CAPABILITY_MISMATCH",
            "F11_WRONG_PERIOD_RULE",
            "F12_UNSEEN_NOTICE_LEAD",
            "F13_WEIGHT_BASIS_CONFLICT",
            "F14_OUT_OF_SCOPE_REGIME",
            "F15_EXTRACTION_PAGE_LOSS",
            "F16_PROMPT_INJECTION"
          ],
          "title": "Issue Type",
          "type": "string"
        },
        "advisory_status": {
          "enum": [
            "RECONCILED_WITHIN_SCOPE",
            "DISCREPANCY_DETECTED",
            "PENDING_VERIFICATION",
            "REQUIRES_EXPERT_REVIEW"
          ],
          "title": "Advisory Status",
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence_ref_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "abstention_reason": {
          "anyOf": [
            {
              "enum": [
                "MISSING_EVIDENCE",
                "MISSING_AUTHORITY",
                "RULE_CONFLICT",
                "TEMPORAL_UNCERTAINTY",
                "UNSUPPORTED_FEATURE",
                "INCOMPLETE_HISTORY",
                "BUDGET_LIMIT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstention Reason"
        },
        "withheld_claim_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Withheld Claim Scopes",
          "type": "array"
        },
        "next_action_kind": {
          "enum": [
            "INVESTIGATE",
            "REQUEST_EVIDENCE",
            "ESCALATE",
            "NO_FURTHER_ACTION"
          ],
          "title": "Next Action Kind",
          "type": "string"
        },
        "next_action_text": {
          "minLength": 1,
          "title": "Next Action Text",
          "type": "string"
        }
      },
      "required": [
        "issue_type",
        "advisory_status",
        "basis",
        "evidence_ref_ids",
        "next_action_kind",
        "next_action_text"
      ],
      "title": "FindingProposal",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Assessment Id",
      "type": "string"
    },
    "operation_ref": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Operation Ref",
      "type": "string"
    },
    "plan_ref": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Plan Ref",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Observation Refs",
      "type": "array"
    },
    "verdict": {
      "enum": [
        "SUPPORTS",
        "REFUTES",
        "WEAK",
        "NO_PROGRESS",
        "UNKNOWN"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "weak_result_or_mistake": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Weak Result Or Mistake"
    },
    "next_check_or_stop": {
      "minLength": 1,
      "title": "Next Check Or Stop",
      "type": "string"
    },
    "revised_plan_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revised Plan Ref"
    },
    "disposition": {
      "enum": [
        "CONTINUE",
        "RESOLVE",
        "ABSTAIN"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "finding_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "assessment_id",
    "operation_ref",
    "plan_ref",
    "observation_refs",
    "verdict",
    "weak_result_or_mistake",
    "next_check_or_stop",
    "revised_plan_ref",
    "disposition"
  ],
  "title": "ObservationAssessment",
  "type": "object"
}
