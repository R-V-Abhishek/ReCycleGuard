{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "NonnegativeMass": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "title": "Decimal",
          "type": "string"
        },
        "unit": {
          "enum": [
            "KG",
            "TONNE",
            "INR",
            "UNIT_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "METAL_MASS",
            "EQUIPMENT_MASS",
            "MONEY",
            "COUNT"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "metal": {
          "anyOf": [
            {
              "enum": [
                "AU",
                "CU",
                "AL",
                "FE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metal"
        }
      },
      "required": [
        "decimal",
        "unit",
        "dimension",
        "metal"
      ],
      "title": "NonnegativeMass",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "title": "Decimal",
          "type": "string"
        },
        "unit": {
          "enum": [
            "KG",
            "TONNE",
            "INR",
            "UNIT_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "METAL_MASS",
            "EQUIPMENT_MASS",
            "MONEY",
            "COUNT"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "metal": {
          "anyOf": [
            {
              "enum": [
                "AU",
                "CU",
                "AL",
                "FE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metal"
        }
      },
      "required": [
        "decimal",
        "unit",
        "dimension",
        "metal"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SignedAdjustment": {
      "additionalProperties": false,
      "properties": {
        "adjustment_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Adjustment Id",
          "type": "string"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "basis_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Basis Refs",
          "type": "array"
        },
        "review_ref": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Review Ref",
          "type": "string"
        }
      },
      "required": [
        "adjustment_id",
        "quantity",
        "basis_refs",
        "review_ref"
      ],
      "title": "SignedAdjustment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Record Id",
      "type": "string"
    },
    "record_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Record Revision Id",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Case Id",
      "type": "string"
    },
    "observation_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Observation Refs",
      "type": "array"
    },
    "derived_from_record_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Derived From Record Refs",
      "type": "array"
    },
    "validation_state": {
      "enum": [
        "VALID",
        "REVIEW_REQUIRED",
        "INVALID"
      ],
      "title": "Validation State",
      "type": "string"
    },
    "created_by_operation_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Created By Operation Id",
      "type": "string"
    },
    "supersedes_revision_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes Revision Id"
    },
    "record_type": {
      "const": "ObligationBucket",
      "title": "Record Type",
      "type": "string"
    },
    "bucket_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Bucket Id",
      "type": "string"
    },
    "producer_entity_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Producer Entity Id",
      "type": "string"
    },
    "liability_year": {
      "pattern": "^\\d{4}-\\d{4}$",
      "title": "Liability Year",
      "type": "string"
    },
    "component": {
      "minLength": 1,
      "title": "Component",
      "type": "string"
    },
    "metal": {
      "enum": [
        "AU",
        "CU",
        "AL",
        "FE"
      ],
      "title": "Metal",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/NonnegativeMass"
    },
    "basis": {
      "enum": [
        "SUPPLIED_ACCOUNT",
        "REVIEWED_CALCULATION"
      ],
      "title": "Basis",
      "type": "string"
    },
    "basis_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Basis Refs",
      "type": "array"
    },
    "profile_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "adjustments": {
      "items": {
        "$ref": "#/$defs/SignedAdjustment"
      },
      "title": "Adjustments",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "record_revision_id",
    "case_id",
    "observation_refs",
    "derived_from_record_refs",
    "validation_state",
    "created_by_operation_id",
    "supersedes_revision_id",
    "record_type",
    "bucket_id",
    "producer_entity_id",
    "liability_year",
    "component",
    "metal",
    "target",
    "basis",
    "basis_refs",
    "profile_id"
  ],
  "title": "ObligationBucket",
  "type": "object"
}
