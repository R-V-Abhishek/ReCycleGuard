{
  "$defs": {
    "ArtifactRevision": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "original_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Filename"
        },
        "source_kind": {
          "enum": [
            "GAZETTE",
            "OFFICIAL_GUIDANCE",
            "PORTAL_CAPTURE",
            "COMPANY_RECORD",
            "SYNTHETIC_RECORD",
            "AGGREGATE_STATISTICS",
            "RESEARCH_NOTE"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "doc_type": {
          "enum": [
            "STATUTORY_INSTRUMENT",
            "SOP",
            "TECHNICAL_FRAMEWORK",
            "FAQ",
            "PORTAL_INSTRUCTION",
            "NOTICE",
            "REGISTRATION_CERTIFICATE",
            "PORTAL_SNAPSHOT",
            "PORTAL_EPR_CERTIFICATE",
            "GST_INVOICE",
            "ERP_CSV",
            "CONTRACT",
            "PURCHASE_ORDER",
            "PAYMENT_RECORD",
            "WEIGHT_TICKET",
            "RECYCLING_ACKNOWLEDGMENT",
            "DESTRUCTION_CERTIFICATE",
            "AWARENESS_PROOF",
            "RETURN_DRAFT",
            "FILING_ACKNOWLEDGMENT",
            "OTHER"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "establishes": {
          "items": {
            "enum": [
              "IDENTITY",
              "REGISTRATION_COVERAGE",
              "REPORTED_ACCOUNT_POSITION",
              "CERTIFICATE_IDENTITY",
              "TRANSFER_STAGE",
              "LIABILITY_ALLOCATION",
              "PAYMENT",
              "PHYSICAL_MOVEMENT",
              "DESTRUCTION",
              "AWARENESS_ACTIVITY",
              "FILING_RECEIPT",
              "RULE_TEXT",
              "CONTEXT_ONLY"
            ],
            "type": "string"
          },
          "title": "Establishes",
          "type": "array"
        },
        "does_not_establish": {
          "items": {
            "enum": [
              "IDENTITY",
              "REGISTRATION_COVERAGE",
              "REPORTED_ACCOUNT_POSITION",
              "CERTIFICATE_IDENTITY",
              "TRANSFER_STAGE",
              "LIABILITY_ALLOCATION",
              "PAYMENT",
              "PHYSICAL_MOVEMENT",
              "DESTRUCTION",
              "AWARENESS_ACTIVITY",
              "FILING_RECEIPT",
              "RULE_TEXT",
              "CONTEXT_ONLY"
            ],
            "type": "string"
          },
          "title": "Does Not Establish",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "fetch_attempt_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fetch Attempt Id"
        },
        "captured_at": {
          "$ref": "#/$defs/TemporalValue"
        },
        "ingested_at": {
          "title": "Ingested At",
          "type": "string"
        },
        "access_policy_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Access Policy Id",
          "type": "string"
        },
        "rights_decision_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Rights Decision Id",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "derived_from": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        }
      },
      "required": [
        "artifact_id",
        "artifact_revision_id",
        "blob",
        "original_filename",
        "source_kind",
        "doc_type",
        "establishes",
        "does_not_establish",
        "source_url",
        "fetch_attempt_id",
        "captured_at",
        "ingested_at",
        "access_policy_id",
        "rights_decision_id",
        "synthetic",
        "derived_from"
      ],
      "title": "ArtifactRevision",
      "type": "object"
    },
    "AssetEntry": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "body_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Body Digest",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "logical_record_type": {
          "title": "Logical Record Type",
          "type": "string"
        },
        "source_capture_time": {
          "$ref": "#/$defs/TemporalValue"
        },
        "visibility": {
          "const": "VISIBLE",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "media_type",
        "body_digest",
        "byte_length",
        "logical_record_type",
        "source_capture_time",
        "visibility"
      ],
      "title": "AssetEntry",
      "type": "object"
    },
    "AssetReceipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Receipt Id",
          "type": "string"
        },
        "batch_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Batch Id",
          "type": "string"
        },
        "declared_asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Declared Asset Id"
        },
        "supplied_path_or_url": {
          "title": "Supplied Path Or Url",
          "type": "string"
        },
        "intake_status": {
          "enum": [
            "RECEIVED",
            "DECLARED_MISSING",
            "REJECTED_ACCESS",
            "FETCH_FAILED"
          ],
          "title": "Intake Status",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "received_at": {
          "title": "Received At",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "batch_id",
        "declared_asset_id",
        "supplied_path_or_url",
        "intake_status",
        "artifact_revision_id",
        "reason",
        "received_at"
      ],
      "title": "AssetReceipt",
      "type": "object"
    },
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "CaseManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Case Id",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "watermark": {
          "const": "SYNTHETIC - NOT A CPCB RECORD",
          "title": "Watermark",
          "type": "string"
        },
        "producer_entity_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Producer Entity Id",
          "type": "string"
        },
        "fiscal_year": {
          "pattern": "^\\d{4}-\\d{4}$",
          "title": "Fiscal Year",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end_exclusive": {
          "format": "date",
          "title": "Period End Exclusive",
          "type": "string"
        },
        "quarter": {
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "ANNUAL"
          ],
          "title": "Quarter",
          "type": "string"
        },
        "allowed_eee_codes": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Eee Codes",
          "type": "array"
        },
        "allowed_metals": {
          "items": {
            "enum": [
              "AU",
              "CU",
              "AL",
              "FE"
            ],
            "type": "string"
          },
          "title": "Allowed Metals",
          "type": "array"
        },
        "calculation_profile_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Calculation Profile Id",
          "type": "string"
        },
        "business_cutoff": {
          "$ref": "#/$defs/TemporalValue"
        },
        "knowledge_cutoff": {
          "title": "Knowledge Cutoff",
          "type": "string"
        },
        "adapter_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Adapter Versions",
          "type": "object"
        },
        "evidence_expectations": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Expectations",
          "type": "array"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/AssetEntry"
          },
          "title": "Assets",
          "type": "array"
        },
        "optional_table_dispositions": {
          "items": {
            "$ref": "#/$defs/TableDisposition"
          },
          "title": "Optional Table Dispositions",
          "type": "array"
        },
        "status": {
          "enum": [
            "DRAFT",
            "APPROVED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "synthetic",
        "watermark",
        "producer_entity_id",
        "fiscal_year",
        "period_start",
        "period_end_exclusive",
        "quarter",
        "allowed_eee_codes",
        "allowed_metals",
        "calculation_profile_id",
        "business_cutoff",
        "knowledge_cutoff",
        "adapter_versions",
        "evidence_expectations",
        "assets",
        "optional_table_dispositions",
        "status"
      ],
      "title": "CaseManifest",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Issue Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "INVALID_SCHEMA",
            "ACCESS_DENIED",
            "HASH_MISMATCH",
            "MISSING_ARTIFACT",
            "INCOMPLETE_COVERAGE",
            "EXTRACTION_FAILED",
            "UNCONFIRMED_IDENTIFIER",
            "AMBIGUOUS_IDENTITY",
            "AMBIGUOUS_EVENT",
            "DIMENSION_MISMATCH",
            "NUMERIC_PRECISION_EXCEEDED",
            "EARLIER_LIABILITY_UNMET",
            "LIABILITY_PRIORITY_UNRESOLVED",
            "UNSUPPORTED_PROFILE",
            "UNAPPROVED_PROFILE",
            "APPLICABILITY_UNRESOLVED",
            "RULE_CONFLICT",
            "SOURCE_INCOMPLETE",
            "STALE_SNAPSHOT",
            "BUDGET_EXHAUSTED",
            "CYCLE_DETECTED",
            "PROVIDER_TIMEOUT",
            "PROVIDER_INVALID_OUTPUT",
            "AUDIT_UNAVAILABLE",
            "CONCURRENT_MODIFICATION",
            "STALE_REVIEW",
            "EXPORT_RESTRICTED",
            "PROHIBITED_VERDICT",
            "CANCELLED",
            "INTEGRITY_FAILED"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "field_path",
        "evidence_refs",
        "retryable"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "TableDisposition": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "title": "Table",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "ABSENT",
            "PRESENT",
            "UNSUPPORTED"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "table",
        "disposition",
        "reason"
      ],
      "title": "TableDisposition",
      "type": "object"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DATE",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone"
        },
        "interpretation_status": {
          "enum": [
            "PARSED",
            "REVIEWED",
            "AMBIGUOUS",
            "UNKNOWN"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "title": "Batch Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Case Id"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/AssetReceipt"
      },
      "title": "Receipts",
      "type": "array"
    },
    "artifact_revisions": {
      "items": {
        "$ref": "#/$defs/ArtifactRevision"
      },
      "title": "Artifact Revisions",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "batch_id",
    "case_id",
    "receipts",
    "artifact_revisions",
    "issues"
  ],
  "title": "IntakeBatchResult",
  "type": "object"
}
