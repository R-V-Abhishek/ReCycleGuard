{
  "$defs": {
    "ExpansionPolicy": {
      "additionalProperties": false,
      "description": "Context expansion settings for retrieval evidence bundles (CONTRACTS §6.1).",
      "properties": {
        "include_parent": {
          "default": true,
          "title": "Include Parent",
          "type": "boolean"
        },
        "include_table_header": {
          "default": true,
          "title": "Include Table Header",
          "type": "boolean"
        },
        "include_footnotes": {
          "default": true,
          "title": "Include Footnotes",
          "type": "boolean"
        },
        "include_applicable_amendments": {
          "default": true,
          "title": "Include Applicable Amendments",
          "type": "boolean"
        },
        "include_references": {
          "default": false,
          "title": "Include References",
          "type": "boolean"
        },
        "max_depth": {
          "default": 2,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_nodes": {
          "default": 20,
          "maximum": 100,
          "minimum": 0,
          "title": "Max Nodes",
          "type": "integer"
        }
      },
      "title": "ExpansionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Direct locator resolution request (CONTRACTS §6.1).",
  "properties": {
    "corpus_snapshot_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Corpus Snapshot Id",
      "type": "string"
    },
    "source_alias_or_source_version_id": {
      "title": "Source Alias Or Source Version Id",
      "type": "string"
    },
    "legal_path": {
      "title": "Legal Path",
      "type": "string"
    },
    "question_basis": {
      "default": "REPORTING_PERIOD",
      "enum": [
        "TRANSACTION_DATE",
        "CAPTURE_DATE",
        "REPORTING_PERIOD",
        "FILING_DATE"
      ],
      "title": "Question Basis",
      "type": "string"
    },
    "applicability_context": {
      "additionalProperties": true,
      "title": "Applicability Context",
      "type": "object"
    },
    "expansion_policy": {
      "$ref": "#/$defs/ExpansionPolicy"
    }
  },
  "required": [
    "corpus_snapshot_id",
    "source_alias_or_source_version_id",
    "legal_path"
  ],
  "title": "LocatorLookupRequest",
  "type": "object"
}
