{
  "$defs": {
    "BudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "max_case_actions": {
          "default": 64,
          "minimum": 1,
          "title": "Max Case Actions",
          "type": "integer"
        },
        "max_model_calls": {
          "default": 24,
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 49152,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "tokens_per_model_call": {
          "default": 2048,
          "minimum": 1,
          "title": "Tokens Per Model Call",
          "type": "integer"
        },
        "max_wall_seconds": {
          "default": 300,
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        },
        "tools_per_finding": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Tools Per Finding",
          "type": "integer"
        },
        "reformulations_per_finding": {
          "default": 2,
          "maximum": 2,
          "minimum": 0,
          "title": "Reformulations Per Finding",
          "type": "integer"
        },
        "retries_per_operation": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Retries Per Operation",
          "type": "integer"
        },
        "report_repairs": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Report Repairs",
          "type": "integer"
        },
        "preflight_actions": {
          "default": 1,
          "minimum": 1,
          "title": "Preflight Actions",
          "type": "integer"
        },
        "verification_actions": {
          "default": 2,
          "minimum": 1,
          "title": "Verification Actions",
          "type": "integer"
        },
        "cost_ceiling_usd": {
          "default": null,
          "title": "Cost Ceiling Usd",
          "type": "null"
        }
      },
      "title": "BudgetLimits",
      "type": "object"
    },
    "FixedPlan": {
      "additionalProperties": false,
      "description": "V1: a predeclared check sequence pinned with the run. The model only assesses.",
      "properties": {
        "rule_queries": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Rule Queries",
          "type": "array"
        }
      },
      "required": [
        "rule_queries"
      ],
      "title": "FixedPlan",
      "type": "object"
    },
    "JsonValue": {},
    "LocalModelConfig": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "default": "configuration:u01_local_qwen35_9b",
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Configuration Id",
          "type": "string"
        },
        "backend": {
          "default": "mlx",
          "enum": [
            "mlx",
            "llama_cpp"
          ],
          "title": "Backend",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_path": {
          "format": "path",
          "title": "Model Path",
          "type": "string"
        },
        "model_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Model Revision",
          "type": "string"
        },
        "weights_manifest_path": {
          "format": "path",
          "title": "Weights Manifest Path",
          "type": "string"
        },
        "weights_manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Weights Manifest Digest",
          "type": "string"
        },
        "runtime_lock_path": {
          "format": "path",
          "title": "Runtime Lock Path",
          "type": "string"
        },
        "runtime_lock_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Lock Digest",
          "type": "string"
        },
        "runtime_version": {
          "default": "0.32.2",
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        },
        "prompt_template_id": {
          "default": "prompt:u01_qwen_non_thinking_v7",
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Prompt Template Id",
          "type": "string"
        },
        "prompt_version": {
          "default": "u01_non_thinking_v7",
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoint": {
          "default": "http://127.0.0.1:8080/v1/completions",
          "title": "Endpoint",
          "type": "string"
        },
        "max_output_tokens": {
          "default": 1024,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_total_tokens": {
          "default": 32768,
          "minimum": 1,
          "title": "Max Total Tokens",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_model_calls": {
          "default": 12,
          "maximum": 12,
          "minimum": 1,
          "title": "Max Model Calls",
          "type": "integer"
        },
        "stop_sequences": {
          "default": [
            "<|im_end|>",
            "<|endoftext|>"
          ],
          "items": {
            "type": "string"
          },
          "title": "Stop Sequences",
          "type": "array"
        },
        "server_flags": {
          "default": [
            "--decode-concurrency",
            "1",
            "--prompt-concurrency",
            "1",
            "--prompt-cache-size",
            "1",
            "--prefill-step-size",
            "256",
            "--max-tokens",
            "1024"
          ],
          "items": {
            "type": "string"
          },
          "title": "Server Flags",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "model_path",
        "model_revision",
        "weights_manifest_path",
        "weights_manifest_digest",
        "runtime_lock_path",
        "runtime_lock_digest"
      ],
      "title": "LocalModelConfig",
      "type": "object"
    },
    "PromptText": {
      "additionalProperties": false,
      "description": "The whole text of one prompt version. A configuration carries it to the investigator.",
      "properties": {
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "phase_rules": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "PLAN",
              "ASSESS",
              "READ",
              "ANALYZE"
            ]
          },
          "title": "Phase Rules",
          "type": "object"
        },
        "retry_note": {
          "minLength": 1,
          "title": "Retry Note",
          "type": "string"
        }
      },
      "required": [
        "prompt_version",
        "system",
        "phase_rules",
        "retry_note"
      ],
      "title": "PromptText",
      "type": "object"
    },
    "ScriptedExchange": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "PLAN",
            "ASSESS",
            "READ",
            "ANALYZE"
          ],
          "title": "Phase",
          "type": "string"
        },
        "response": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Response",
          "type": "object"
        }
      },
      "required": [
        "phase",
        "response"
      ],
      "title": "ScriptedExchange",
      "type": "object"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "description": "Pinned reference; introduced by A02, not an implemented C05 lookup.",
      "properties": {
        "snapshot_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "membership_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Membership Digest",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "membership_digest"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Run Id",
      "type": "string"
    },
    "case_snapshot": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "corpus_snapshot": {
      "$ref": "#/$defs/SnapshotRef"
    },
    "finding_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Finding Ids",
      "type": "array"
    },
    "scripted_exchanges": {
      "items": {
        "$ref": "#/$defs/ScriptedExchange"
      },
      "title": "Scripted Exchanges",
      "type": "array"
    },
    "local_model_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalModelConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fixed_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/FixedPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agents": {
      "anyOf": [
        {
          "enum": [
            "READER_ANALYST",
            "ANALYST_ONLY"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agents"
    },
    "budgets": {
      "$ref": "#/$defs/BudgetLimits"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    }
  },
  "required": [
    "run_id",
    "case_snapshot",
    "corpus_snapshot",
    "finding_ids"
  ],
  "title": "InvestigationRequest",
  "type": "object"
}
