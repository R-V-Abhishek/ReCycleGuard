{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "CoverageItem": {
      "additionalProperties": false,
      "description": "Page or row disposition record guaranteeing intake accounting (CONTRACTS §3.3).",
      "properties": {
        "coverage_item_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Coverage Item Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "disposition": {
          "enum": [
            "PARSED",
            "QUARANTINED",
            "EXCLUDED",
            "FAILED",
            "NOT_APPLICABLE"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "child_observation_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
            "type": "string"
          },
          "title": "Child Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "coverage_item_id",
        "artifact_revision_id",
        "locator",
        "disposition",
        "reason_code",
        "child_observation_ids"
      ],
      "title": "CoverageItem",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExtractionResult": {
      "additionalProperties": false,
      "description": "Structured extraction outcome with terminal coverage and raw text reference.",
      "properties": {
        "extraction_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Extraction Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "title": "Adapter Version",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "text_blob": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "observations_blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "coverage_blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "extraction_id",
        "artifact_revision_id",
        "adapter_id",
        "adapter_version",
        "configuration_digest",
        "text_blob",
        "observations_blob",
        "coverage_blob",
        "status",
        "issues"
      ],
      "title": "ExtractionResult",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Issue Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "INVALID_SCHEMA",
            "ACCESS_DENIED",
            "HASH_MISMATCH",
            "MISSING_ARTIFACT",
            "INCOMPLETE_COVERAGE",
            "EXTRACTION_FAILED",
            "UNCONFIRMED_IDENTIFIER",
            "AMBIGUOUS_IDENTITY",
            "AMBIGUOUS_EVENT",
            "DIMENSION_MISMATCH",
            "NUMERIC_PRECISION_EXCEEDED",
            "EARLIER_LIABILITY_UNMET",
            "LIABILITY_PRIORITY_UNRESOLVED",
            "UNSUPPORTED_PROFILE",
            "UNAPPROVED_PROFILE",
            "APPLICABILITY_UNRESOLVED",
            "RULE_CONFLICT",
            "SOURCE_INCOMPLETE",
            "STALE_SNAPSHOT",
            "BUDGET_EXHAUSTED",
            "CYCLE_DETECTED",
            "PROVIDER_TIMEOUT",
            "PROVIDER_INVALID_OUTPUT",
            "AUDIT_UNAVAILABLE",
            "CONCURRENT_MODIFICATION",
            "STALE_REVIEW",
            "EXPORT_RESTRICTED",
            "PROHIBITED_VERDICT",
            "CANCELLED",
            "INTEGRITY_FAILED",
            "OVER_ALLOCATION",
            "UNSUPPORTED_FEATURE"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "field_path",
        "evidence_refs",
        "retryable"
      ],
      "title": "Issue",
      "type": "object"
    },
    "JsonValue": {},
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "Raw and parsed observation with extraction provenance and temporal triad (CONTRACTS §3.3).",
      "properties": {
        "observation_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Observation Id",
          "type": "string"
        },
        "extraction_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Extraction Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Artifact Revision Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "observation_type": {
          "title": "Observation Type",
          "type": "string"
        },
        "raw_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw Fields",
          "type": "object"
        },
        "parsed_fields": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parsed Fields",
          "type": "object"
        },
        "validation_state": {
          "enum": [
            "VALID",
            "REVIEW_REQUIRED",
            "INVALID"
          ],
          "title": "Validation State",
          "type": "string"
        },
        "extraction_method": {
          "enum": [
            "CSV",
            "JSON",
            "PDF_TEXT",
            "PDF_TABLE",
            "OCR",
            "HUMAN_ASSERTION"
          ],
          "title": "Extraction Method",
          "type": "string"
        },
        "field_quality": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Field Quality",
          "type": "object"
        },
        "event_time": {
          "$ref": "#/$defs/TemporalValue"
        },
        "source_capture_time": {
          "$ref": "#/$defs/TemporalValue"
        },
        "ingestion_time": {
          "title": "Ingestion Time",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "extraction_id",
        "artifact_revision_id",
        "locator",
        "observation_type",
        "raw_fields",
        "parsed_fields",
        "validation_state",
        "extraction_method",
        "field_quality",
        "event_time",
        "source_capture_time",
        "ingestion_time"
      ],
      "title": "Observation",
      "type": "object"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DATE",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone"
        },
        "interpretation_status": {
          "enum": [
            "PARSED",
            "REVIEWED",
            "AMBIGUOUS",
            "UNKNOWN"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/ExtractionResult"
      },
      "title": "Results",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageItem"
      },
      "title": "Coverage",
      "type": "array"
    }
  },
  "required": [
    "results",
    "observations",
    "coverage"
  ],
  "title": "ExtractedBatch",
  "type": "object"
}
