{
  "$defs": {
    "ActionDraft": {
      "additionalProperties": false,
      "properties": {
        "action_kind": {
          "enum": [
            "CHECK",
            "REFORMULATE"
          ],
          "title": "Action Kind",
          "type": "string"
        },
        "allowed_operation": {
          "minLength": 1,
          "title": "Allowed Operation",
          "type": "string"
        },
        "typed_arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Typed Arguments",
          "type": "object"
        },
        "finding_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Finding Id",
          "type": "string"
        },
        "concise_reason": {
          "minLength": 1,
          "title": "Concise Reason",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "action_kind",
        "allowed_operation",
        "typed_arguments",
        "finding_id",
        "concise_reason",
        "evidence_refs"
      ],
      "title": "ActionDraft",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "JsonValue": {},
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "PlanDraft": {
      "additionalProperties": false,
      "properties": {
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "proposed_checks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Proposed Checks",
          "type": "array"
        },
        "expected_evidence": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Evidence",
          "type": "array"
        },
        "stopping_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stopping Criteria",
          "type": "array"
        }
      },
      "required": [
        "objective",
        "hypotheses",
        "proposed_checks",
        "expected_evidence",
        "stopping_criteria"
      ],
      "title": "PlanDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "action": {
          "type": "object"
        },
        "stop_reason": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "action": {
          "type": "null"
        },
        "stop_reason": {
          "enum": [
            "NO_NEW_EVIDENCE",
            "EXPERT_REVIEW_REQUIRED"
          ]
        }
      }
    }
  ],
  "properties": {
    "plan": {
      "$ref": "#/$defs/PlanDraft"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_reason": {
      "anyOf": [
        {
          "enum": [
            "NO_NEW_EVIDENCE",
            "EXPERT_REVIEW_REQUIRED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Stop Reason"
    }
  },
  "required": [
    "plan",
    "action",
    "stop_reason"
  ],
  "title": "PlanProposal",
  "type": "object"
}
