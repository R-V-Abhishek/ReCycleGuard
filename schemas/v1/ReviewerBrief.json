{
  "$defs": {
    "BriefFigure": {
      "additionalProperties": false,
      "description": "One number shown with a brief, copied by code from the authoritative calculation.",
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "value_ref": {
          "$ref": "#/$defs/CalculationValueRef"
        }
      },
      "required": [
        "label",
        "value",
        "value_ref"
      ],
      "title": "BriefFigure",
      "type": "object"
    },
    "BriefProposal": {
      "additionalProperties": false,
      "description": "A model's draft reviewer brief for one verified finding.\n\nText only, in words: code adds every number. Lengths and references are checked by the brief\ngate, so a bad draft is a retained rejection rather than a failed call.",
      "properties": {
        "what_to_check": {
          "minLength": 1,
          "title": "What To Check",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_request": {
          "minLength": 1,
          "title": "Evidence Request",
          "type": "string"
        },
        "evidence_ref_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ref Ids",
          "type": "array"
        }
      },
      "required": [
        "what_to_check",
        "explanation",
        "evidence_request",
        "evidence_ref_ids"
      ],
      "title": "BriefProposal",
      "type": "object"
    },
    "CalculationValueRef": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Calculation Id",
          "type": "string"
        },
        "bucket_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Bucket Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "required",
            "supported",
            "signed_gap",
            "shortfall",
            "surplus",
            "pending",
            "portal_reported",
            "ledger_supported",
            "delta"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "calculation_id",
        "bucket_id",
        "field"
      ],
      "title": "CalculationValueRef",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Advisory reading aid for one finding of one report revision. It changes nothing.\n\nA model brief that fails the gate, or whose call did not complete, is kept with its reason\nand no text. A template brief is built by code from the finding alone.",
  "properties": {
    "brief_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Brief Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Run Id",
      "type": "string"
    },
    "report_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Report Revision Id",
      "type": "string"
    },
    "finding_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Finding Revision Id",
      "type": "string"
    },
    "issue_type": {
      "enum": [
        "F01_CLEAN_BASELINE",
        "F02_OVERLAPPING_EXPORT",
        "F03_MULTISTAGE_ID_REUSE",
        "F04_UNIT_DIMENSION_MIX",
        "F05_WRONG_ENTITY_ALIAS",
        "F06_STALE_SNAPSHOT",
        "F07_PAID_NO_TRANSFER",
        "F08_PRIOR_ARREARS_DRAIN",
        "F09_EXPIRED_CANCELLED",
        "F10_CAPABILITY_MISMATCH",
        "F11_WRONG_PERIOD_RULE",
        "F12_UNSEEN_NOTICE_LEAD",
        "F13_WEIGHT_BASIS_CONFLICT",
        "F14_OUT_OF_SCOPE_REGIME",
        "F15_EXTRACTION_PAGE_LOSS",
        "F16_PROMPT_INJECTION"
      ],
      "title": "Issue Type",
      "type": "string"
    },
    "source": {
      "enum": [
        "MODEL",
        "TEMPLATE"
      ],
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "DROPPED"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    },
    "what_to_check": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "What To Check"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Explanation"
    },
    "evidence_request": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidence Request"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "figures": {
      "items": {
        "$ref": "#/$defs/BriefFigure"
      },
      "title": "Figures",
      "type": "array"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "model_operation_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Operation Ref"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/BriefProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "report_revision_id",
    "finding_revision_id",
    "issue_type",
    "source",
    "status",
    "reason",
    "what_to_check",
    "explanation",
    "evidence_request",
    "evidence_refs",
    "figures",
    "label",
    "model_operation_ref"
  ],
  "title": "ReviewerBrief",
  "type": "object"
}
