{
  "additionalProperties": false,
  "description": "Metadata entry for an object bundled in an audit or publication package.",
  "properties": {
    "object_ref": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Object Ref",
      "type": "string"
    },
    "object_kind": {
      "title": "Object Kind",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "byte_length": {
      "title": "Byte Length",
      "type": "integer"
    },
    "media_type": {
      "default": "application/json",
      "title": "Media Type",
      "type": "string"
    }
  },
  "required": [
    "object_ref",
    "object_kind",
    "sha256",
    "byte_length"
  ],
  "title": "IncludedObjectEntry",
  "type": "object"
}
