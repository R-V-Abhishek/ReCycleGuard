{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "TemporalValue": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "precision": {
          "enum": [
            "INSTANT",
            "DATE",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ],
          "title": "Precision",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Timezone"
        },
        "interpretation_status": {
          "enum": [
            "PARSED",
            "REVIEWED",
            "AMBIGUOUS",
            "UNKNOWN"
          ],
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "value",
        "precision",
        "timezone",
        "interpretation_status"
      ],
      "title": "TemporalValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Acquired and versioned primary instrument or operational publication (CONTRACTS §4.1).",
  "properties": {
    "source_version_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Source Version Id",
      "type": "string"
    },
    "source_lead_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Source Lead Id",
      "type": "string"
    },
    "artifact_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Artifact Revision Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "issuer": {
      "title": "Issuer",
      "type": "string"
    },
    "notification_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notification Number"
    },
    "notification_date": {
      "$ref": "#/$defs/TemporalValue"
    },
    "publication_date": {
      "$ref": "#/$defs/TemporalValue"
    },
    "commencement": {
      "$ref": "#/$defs/TemporalValue"
    },
    "commencement_basis_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Commencement Basis Refs",
      "type": "array"
    },
    "website_upload_date": {
      "$ref": "#/$defs/TemporalValue"
    },
    "completeness": {
      "enum": [
        "COMPLETE_TEXT",
        "PARTIAL_TEXT",
        "HTML_SHELL",
        "NOTICE_LEAD"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "review_state": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "REJECTED"
      ],
      "title": "Review State",
      "type": "string"
    }
  },
  "required": [
    "source_version_id",
    "source_lead_id",
    "artifact_revision_id",
    "title",
    "issuer",
    "notification_number",
    "notification_date",
    "publication_date",
    "commencement",
    "commencement_basis_refs",
    "website_upload_date",
    "completeness",
    "review_state"
  ],
  "title": "SourceVersion",
  "type": "object"
}
