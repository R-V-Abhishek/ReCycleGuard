{
  "additionalProperties": false,
  "properties": {
    "case_version_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Case Version Id",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Profile Id",
      "type": "string"
    },
    "bucket_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Bucket Ids",
      "type": "array"
    },
    "expected_input_membership_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Input Membership Digest"
    }
  },
  "required": [
    "case_version_id",
    "profile_id",
    "bucket_ids",
    "expected_input_membership_digest"
  ],
  "title": "CalculationRequest",
  "type": "object"
}
