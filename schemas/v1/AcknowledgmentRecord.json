    "review_ref": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Ref"
    }
  },
  "required": [
    "acknowledgment_id",
    "artifact_revision_id",
    "linked_case_version_id",
    "claimed_external_reference",
    "validation_state"
