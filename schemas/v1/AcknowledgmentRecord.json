      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Acknowledgment Id",
      "type": "string"
    },
    "artifact_revision_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Artifact Revision Id",
      "type": "string"
    },
    "linked_case_version_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Linked Case Version Id",
      "type": "string"
    },
    "linked_report_revision_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linked Report Revision Id"
    },
    "claimed_external_reference": {
      "title": "Claimed External Reference",
      "type": "string"
    },
    "validation_state": {
