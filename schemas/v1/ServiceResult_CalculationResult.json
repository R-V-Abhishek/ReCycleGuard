{
  "$defs": {
    "BlobRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "byte_length",
        "media_type"
      ],
      "title": "BlobRef",
      "type": "object"
    },
    "BucketResult": {
      "additionalProperties": false,
      "properties": {
        "bucket_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Bucket Id",
          "type": "string"
        },
        "required": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "supported": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "signed_gap": {
          "$ref": "#/$defs/Quantity"
        },
        "shortfall": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "surplus": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "pending": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "portal_reported": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonnegativeMass"
            },
            {
              "type": "null"
            }
          ]
        },
        "ledger_supported": {
          "$ref": "#/$defs/NonnegativeMass"
        },
        "delta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_comparison_ref": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Comparison Ref"
        },
        "allocation_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
            "type": "string"
          },
          "title": "Allocation Ids",
          "type": "array"
        },
        "qualification_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Qualification Refs",
          "type": "array"
        }
      },
      "required": [
        "bucket_id",
        "required",
        "supported",
        "signed_gap",
        "shortfall",
        "surplus",
        "pending",
        "portal_reported",
        "ledger_supported",
        "delta",
        "snapshot_comparison_ref",
        "allocation_ids",
        "qualification_refs"
      ],
      "title": "BucketResult",
      "type": "object"
    },
    "CalculationResult": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Calculation Id",
          "type": "string"
        },
        "case_version_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Case Version Id",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Profile Id",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "analyzed_input_membership_blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "analyzed_bucket_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
            "type": "string"
          },
          "title": "Analyzed Bucket Ids",
          "type": "array"
        },
        "bucket_results": {
          "items": {
            "$ref": "#/$defs/BucketResult"
          },
          "title": "Bucket Results",
          "type": "array"
        },
        "quantity_dispositions_blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "derivation_blob": {
          "$ref": "#/$defs/BlobRef"
        },
        "coverage": {
          "enum": [
            "COMPLETE_WITHIN_SCOPE",
            "QUALIFIED",
            "BLOCKED"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "calculation_id",
        "case_version_id",
        "profile_id",
        "tool_version",
        "input_digest",
        "analyzed_input_membership_blob",
        "analyzed_bucket_ids",
        "bucket_results",
        "quantity_dispositions_blob",
        "derivation_blob",
        "coverage",
        "issues"
      ],
      "title": "CalculationResult",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "ref_kind": {
          "enum": [
            "ARTIFACT",
            "OBSERVATION",
            "RECORD",
            "PROVISION",
            "CALCULATION",
            "FINDING"
          ],
          "title": "Ref Kind",
          "type": "string"
        },
        "ref_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Ref Id",
          "type": "string"
        },
        "artifact_revision_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Revision Id"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref_kind",
        "ref_id",
        "artifact_revision_id",
        "locator"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
          "title": "Issue Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "INVALID_SCHEMA",
            "ACCESS_DENIED",
            "HASH_MISMATCH",
            "MISSING_ARTIFACT",
            "INCOMPLETE_COVERAGE",
            "EXTRACTION_FAILED",
            "UNCONFIRMED_IDENTIFIER",
            "AMBIGUOUS_IDENTITY",
            "AMBIGUOUS_EVENT",
            "DIMENSION_MISMATCH",
            "NUMERIC_PRECISION_EXCEEDED",
            "EARLIER_LIABILITY_UNMET",
            "LIABILITY_PRIORITY_UNRESOLVED",
            "UNSUPPORTED_PROFILE",
            "UNAPPROVED_PROFILE",
            "APPLICABILITY_UNRESOLVED",
            "RULE_CONFLICT",
            "SOURCE_INCOMPLETE",
            "STALE_SNAPSHOT",
            "BUDGET_EXHAUSTED",
            "CYCLE_DETECTED",
            "PROVIDER_TIMEOUT",
            "PROVIDER_INVALID_OUTPUT",
            "AUDIT_UNAVAILABLE",
            "CONCURRENT_MODIFICATION",
            "STALE_REVIEW",
            "EXPORT_RESTRICTED",
            "PROHIBITED_VERDICT",
            "CANCELLED",
            "INTEGRITY_FAILED",
            "OVER_ALLOCATION",
            "UNSUPPORTED_FEATURE"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Field Path"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "field_path",
        "evidence_refs",
        "retryable"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Locator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "PDF_PAGE",
            "PDF_CELL",
            "CSV_ROW",
            "JSON_POINTER",
            "TEXT_SPAN",
            "DB_RECORD"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page Index 1Based"
        },
        "printed_page_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Printed Page Label"
        },
        "row_index_1based": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Index 1Based"
        },
        "column_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Column Name"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Json Pointer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text End"
        },
        "table_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Table Id"
        },
        "cell_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Row"
        },
        "cell_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Column"
        }
      },
      "required": [
        "kind",
        "page_index_1based",
        "printed_page_label",
        "row_index_1based",
        "column_name",
        "json_pointer",
        "text_start",
        "text_end",
        "table_id",
        "cell_row",
        "cell_column"
      ],
      "title": "Locator",
      "type": "object"
    },
    "NonnegativeMass": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "title": "Decimal",
          "type": "string"
        },
        "unit": {
          "enum": [
            "KG",
            "TONNE",
            "INR",
            "UNIT_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "METAL_MASS",
            "EQUIPMENT_MASS",
            "MONEY",
            "COUNT"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "metal": {
          "anyOf": [
            {
              "enum": [
                "AU",
                "CU",
                "AL",
                "FE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metal"
        }
      },
      "required": [
        "decimal",
        "unit",
        "dimension",
        "metal"
      ],
      "title": "NonnegativeMass",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "title": "Decimal",
          "type": "string"
        },
        "unit": {
          "enum": [
            "KG",
            "TONNE",
            "INR",
            "UNIT_COUNT"
          ],
          "title": "Unit",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "METAL_MASS",
            "EQUIPMENT_MASS",
            "MONEY",
            "COUNT"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "metal": {
          "anyOf": [
            {
              "enum": [
                "AU",
                "CU",
                "AL",
                "FE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metal"
        }
      },
      "required": [
        "decimal",
        "unit",
        "dimension",
        "metal"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.1",
      "title": "Contract Version",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Operation Id",
      "type": "string"
    },
    "attempt_id": {
      "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
      "title": "Attempt Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "PARTIAL",
        "FAILED",
        "REJECTED",
        "CANCELLED",
        "OUTCOME_UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalculationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "output_blob": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "audit_event_ids": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*:[^\\s]+$",
        "type": "string"
      },
      "title": "Audit Event Ids",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "operation_id",
    "attempt_id",
    "status",
    "output",
    "output_blob",
    "issues",
    "dependencies",
    "audit_event_ids"
  ],
  "title": "ServiceResult[CalculationResult]",
  "type": "object"
}
